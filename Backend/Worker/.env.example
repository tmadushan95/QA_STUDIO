# Placeholders only. Copy to .env (git-ignored). Everything except QA_ALLOWED_ENVS, paths and the token
# can also be changed in the app; values saved in the app win over this file.
# Never put passwords here: add test accounts to a project in Master data (they are stored encrypted).

# Each project has its own address and sign-in (Master data > Projects). These, and QA_LOGIN_* below, are read
# once: the first start after upgrading gives them to the projects that already hold test cases.
QA_ENV_NAME=qa
QA_BASE_URL=https://app-qa.example.invalid
# Environments projects may use. Anything else (e.g. production) is refused.
QA_ALLOWED_ENVS=dev,qa,uat,staging
# Let scenarios that DELETE data run (needs throw-away records named on the Test data page). Off by default.
QA_ALLOW_DESTRUCTIVE=false

QA_BROWSER=chromium
# false shows the browser window while tests run; use true on a server with no screen.
QA_HEADLESS=false
QA_WORKERS=2
QA_TIMEOUT_MS=60000
# Delay in ms before each browser action, so you can follow along (0 = full speed).
QA_SLOW_MO_MS=0

# none, login-form or microsoft-sso
QA_LOGIN_STRATEGY=microsoft-sso
QA_LOGIN_PATH=/login
QA_SIGNED_IN_MARKER=Welcome back,

QA_ARTIFACTS_DIR=artifacts
QA_SECRET_KEY_FILE=data/secret.key

# Link to the QA Studio API (Backend). QA_INTERNAL_TOKEN must equal Worker:InternalToken in
# Backend/appsettings.Development.json or the environment. Generate one: 32+ random characters.
QA_PERSISTENCE_URL=http://127.0.0.1:5080
QA_INTERNAL_TOKEN=

# Voice control (Settings > Voice). The LiveKit project the qa-voice agent and the browser join; leave empty to keep
# voice off. Keys stay on this machine: the browser only ever gets a short-lived token for one room.
# QA_LIVEKIT_URL=wss://your-project.livekit.cloud
# QA_LIVEKIT_API_KEY=
# QA_LIVEKIT_API_SECRET=

# Optional hardening
# QA_ADMIN_TOKEN=            # 16+ characters; must equal Security:AdminToken in the API settings
# QA_SECRET_KEY=             # 32 bytes, base64; otherwise a key file is created next to the database
# QA_ALLOWED_HOSTS=          # extra Host names the API may be reached by
# QA_ALLOWED_ORIGINS=        # extra browser origins allowed to make changes
