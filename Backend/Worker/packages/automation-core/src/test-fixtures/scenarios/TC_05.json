{
  "schemaVersion": 1,
  "caseId": "TC_05",
  "description": "Delete on a Rejected individual project opens the confirmation; nothing is deleted",
  "steps": [
    {
      "action": "drafts.open-project",
      "params": {
        "list": "draft",
        "code": "{{data.rejectedProject}}"
      }
    },
    {
      "action": "project.click-delete",
      "params": {}
    },
    {
      "action": "project.assert-delete-dialog",
      "params": {
        "kind": "individual"
      }
    },
    {
      "action": "project.cancel-delete",
      "params": {}
    }
  ]
}
