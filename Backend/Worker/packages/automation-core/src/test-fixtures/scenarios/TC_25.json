{
  "schemaVersion": 1,
  "caseId": "TC_25",
  "description": "Delete is available on a Draft individual project (user with the permission)",
  "steps": [
    {
      "action": "drafts.open-project",
      "params": {
        "list": "draft",
        "code": "{{data.draftProject}}"
      }
    },
    {
      "action": "project.assert-delete-button",
      "params": {
        "visible": true
      }
    },
    {
      "action": "project.click-delete",
      "params": {}
    },
    {
      "action": "project.assert-delete-dialog",
      "params": {
        "kind": "individual"
      }
    },
    {
      "action": "project.cancel-delete",
      "params": {}
    }
  ]
}
