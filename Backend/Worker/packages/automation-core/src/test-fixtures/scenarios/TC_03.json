{
  "schemaVersion": 1,
  "caseId": "TC_03",
  "description": "No Delete button on a Draft and a Rejected project (user without the permission)",
  "steps": [
    {
      "action": "drafts.open-project",
      "params": {
        "list": "draft",
        "code": "{{data.draftProject}}"
      }
    },
    {
      "action": "project.assert-delete-button",
      "params": {
        "visible": false
      }
    },
    {
      "action": "drafts.open-project",
      "params": {
        "list": "draft",
        "code": "{{data.rejectedProject}}"
      }
    },
    {
      "action": "project.assert-delete-button",
      "params": {
        "visible": false
      }
    }
  ]
}
