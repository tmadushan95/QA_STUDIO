{
  "schemaVersion": 1,
  "caseId": "TC_13",
  "description": "DELETES a Rejected child of a clubbed project",
  "steps": [
    {
      "action": "drafts.open-project",
      "params": {
        "list": "draft",
        "code": "{{data.rejectedChildTc13}}"
      }
    },
    {
      "action": "project.click-delete",
      "params": {}
    },
    {
      "action": "project.assert-delete-dialog",
      "params": {
        "kind": "linked",
        "clubbedCode": "{{data.clubbedCode}}"
      }
    },
    {
      "action": "project.confirm-delete",
      "params": {
        "lrp": false
      }
    },
    {
      "action": "drafts.assert-listed",
      "params": {
        "list": "draft",
        "code": "{{data.rejectedChildTc13}}",
        "listed": false
      }
    }
  ]
}
