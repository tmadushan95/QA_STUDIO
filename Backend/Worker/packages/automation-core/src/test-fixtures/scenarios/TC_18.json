{
  "schemaVersion": 1,
  "caseId": "TC_18",
  "description": "DELETES a Draft LRP project",
  "steps": [
    {
      "action": "drafts.open-project",
      "params": {
        "list": "lrp",
        "code": "{{data.lrpDraftTc18}}"
      }
    },
    {
      "action": "project.click-delete",
      "params": {}
    },
    {
      "action": "project.assert-delete-dialog",
      "params": {
        "kind": "lrp"
      }
    },
    {
      "action": "project.confirm-delete",
      "params": {
        "lrp": true
      }
    },
    {
      "action": "drafts.assert-listed",
      "params": {
        "list": "lrp",
        "code": "{{data.lrpDraftTc18}}",
        "listed": false
      }
    }
  ]
}
