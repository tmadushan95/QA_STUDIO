{
  "name": "qa-studio-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "npm run build && node scripts/start.mjs",
    "worker": "tsc -b && node services/qa-api/dist/server.js",
    "build": "tsc -b && npm --prefix ../../Frontend run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "check": "npm run typecheck && npm run lint && npm run test",
    "voice": "tsc -b && node services/qa-voice/dist/server.js start"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vitest": "2.1.8",
    "@types/node": "22.10.5"
  }
}
