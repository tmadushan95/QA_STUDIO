{
  "name": "@qa-studio/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "QA Studio web app: dashboard, test design, test execution, run history, AI assistant, Azure DevOps, projects & versions, sign-in users and settings.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
