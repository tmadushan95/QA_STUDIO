# =============================================================================
# QA Studio - root .gitignore
# Covers the .NET API (Backend/src, Backend/tests), the Node worker
# (Backend/Worker) and the React app (Frontend).
# Rule of thumb: commit source and config templates; never commit build output,
# installed packages, local machine settings, run evidence or secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets and local-only settings  (NEVER commit these)
# -----------------------------------------------------------------------------
# Worker settings: copy Backend/Worker/.env.example to .env and fill it in.
.env
.env.*
!.env.example
# Key that decrypts stored passwords and AI keys.
*.key
*.pem
*.pfx
*.p12
# API secrets shared with the worker (see Backend/README.md for the template).
appsettings.Development.json
appsettings.*.local.json
appsettings.Local.json
secrets.json

# -----------------------------------------------------------------------------
# Runtime data produced by the worker
# -----------------------------------------------------------------------------
Backend/Worker/data/
Backend/Worker/artifacts/
Backend/Worker/reports/
playwright-report/
test-results/
blob-report/
*.trace.zip
trace.zip

# -----------------------------------------------------------------------------
# Node / TypeScript / Vite
# -----------------------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
.eslintcache
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# .NET build output
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Aa]rtifacts/
x64/
x86/
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
*.nupkg
*.snupkg
.dotnet-artifacts/
# Local publish profiles may hold credentials.
*.pubxml
*.pubxml.user
*.publishsettings
PublishProfiles/

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp
*~

# -----------------------------------------------------------------------------
# Tooling output
# -----------------------------------------------------------------------------
# Knowledge-graph output generated by graphify (rebuild with /graphify).
graphify-out/
# Claude Code local session settings.
.claude/settings.local.json

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
